# Copier ce fichier en .env.local puis renseigner les valeurs.
# Adresse des fonctions RPC du Supabase local (PostgREST).
SUPA_URL=http://192.168.11.214:30736/rest/v1/rpc
# Clé anon de Supabase (Studio > Settings > API).
SUPA_ANON_KEY=
# Jeton du client `ui` : select sup.api_new_token('ui'); dans Supabase Studio.
SUPA_TOKEN=
# true : données de démonstration (src/mock). false : base réelle, sans repli sur la démonstration.
USE_MOCK=true
# Facultatif : région du profil coordinateur de démonstration (défaut : L'Oriental).
# UMMC_COORD_REGION=L'Oriental
